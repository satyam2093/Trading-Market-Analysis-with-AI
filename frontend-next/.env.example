# Public API base URL. Do not include a trailing slash.
# Local: http://localhost:8000
# Production example: https://your-api.example.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# Public WebSocket base URL. Use wss:// when the API is served over HTTPS.
# Production example: wss://your-api.example.com
NEXT_PUBLIC_WS_URL=ws://localhost:8000
