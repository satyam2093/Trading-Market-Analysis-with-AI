# Database Configuration
DATABASE_URL=sqlite:///./ai_market_intelligence.db
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_market_db

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=super-secret-key-change-in-production

# Browser origins permitted to call the FastAPI service. Separate multiple
# production domains with commas; do not include a trailing slash.
CORS_ALLOW_ORIGINS=http://localhost:3000

# API Keys (Optional external providers)
ALPHA_VANTAGE_API_KEY=
NEWS_API_KEY=

# Cache
REDIS_URL=redis://localhost:6379/0
